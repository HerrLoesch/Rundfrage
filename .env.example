# Rundfrage - local configuration
#
# None of this is required to start the system: compose.yaml carries the same
# values as inline defaults, so `docker compose up` works on a fresh clone with
# no .env present (FR-001, SC-002, research.md R-11).
#
# Copy to .env only when you want to override something. .env is git-ignored.

# --- Database -------------------------------------------------------------
POSTGRES_USER=rundfrage
# Development-only default. Never reuse this outside local work (FR-005).
POSTGRES_PASSWORD=rundfrage_dev
POSTGRES_DB=rundfrage

# --- Application ----------------------------------------------------------
# Serilog minimum level. Change without rebuilding (FR-025).
# Verbose | Debug | Information | Warning | Error | Fatal
LOG_LEVEL=Information

# Host port the application is published on.
APP_PORT=8080
