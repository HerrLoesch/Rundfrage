{
  "description": "Shared valid/invalid cases for every field type (010 FR-023 to FR-030, research R-7), and shared cases for what counts as an answer at all (FR-017). Consumed by both FormFieldValidationTests.cs (xUnit) and useFormFieldValidation.spec.ts (Vitest) so the two implementations cannot silently disagree.",
  "cases": [
    { "type": "text", "field": { "maxLength": 10, "minLength": 2 }, "value": "Anna", "expectedValid": true },
    { "type": "text", "field": { "maxLength": 10, "minLength": 2 }, "value": "A", "expectedValid": false },
    { "type": "text", "field": { "maxLength": 10, "minLength": 2 }, "value": "AnnaBeatrix", "expectedValid": false },
    { "type": "text", "field": { "maxLength": 10 }, "value": "1234567890", "expectedValid": true },
    { "type": "integer", "value": "42", "expectedValid": true },
    { "type": "integer", "value": "-7", "expectedValid": true },
    { "type": "integer", "value": "3.14", "expectedValid": false },
    { "type": "integer", "value": "abc", "expectedValid": false },
    { "type": "integer", "value": "+5", "expectedValid": true },
    { "type": "integer", "value": "9223372036854775807", "expectedValid": true },
    { "type": "integer", "value": "9223372036854775808", "expectedValid": false },
    { "type": "integer", "value": "42\n", "expectedValid": false },
    { "type": "decimal", "value": "3.14", "expectedValid": true },
    { "type": "decimal", "value": "-0.5", "expectedValid": true },
    { "type": "decimal", "value": "42", "expectedValid": true },
    { "type": "decimal", "value": "abc", "expectedValid": false },
    { "type": "decimal", "value": "0.5", "expectedValid": true },
    { "type": "decimal", "value": ".5", "expectedValid": true },
    { "type": "decimal", "value": "NaN", "expectedValid": false },
    { "type": "decimal", "value": "Infinity", "expectedValid": false },
    { "type": "decimal", "value": "1e5", "expectedValid": false },
    { "type": "decimal", "value": "", "expectedValid": false },
    { "type": "decimal", "value": "1,5", "expectedValid": false },
    { "type": "boolean", "value": "yes", "expectedValid": true },
    { "type": "boolean", "value": "no", "expectedValid": true },
    { "type": "boolean", "value": "true", "expectedValid": false },
    { "type": "boolean", "value": "false", "expectedValid": false },
    { "type": "boolean", "value": "1", "expectedValid": false },
    { "type": "email", "value": "anna@example.com", "expectedValid": true },
    { "type": "email", "value": "anna@example", "expectedValid": false },
    { "type": "email", "value": "annaexample.com", "expectedValid": false },
    { "type": "email", "value": "anna @example.com", "expectedValid": false },
    { "type": "email", "value": "anna@example.com\n", "expectedValid": false },
    { "type": "phone", "value": "+49 30 1234567", "expectedValid": true },
    { "type": "phone", "value": "030-1234567", "expectedValid": true },
    { "type": "phone", "value": "123456", "expectedValid": false },
    { "type": "phone", "value": "call me", "expectedValid": false },
    { "type": "postalCode", "value": "01067", "expectedValid": true },
    { "type": "postalCode", "value": "1067", "expectedValid": false },
    { "type": "postalCode", "value": "010670", "expectedValid": false },
    { "type": "postalCode", "value": "ABCDE", "expectedValid": false },
    { "type": "postalCode", "value": "01067\n", "expectedValid": false },
    { "type": "postalCode", "value": "١٢٣٤٥", "expectedValid": false }
  ],
  "answeredCases": [
    { "value": null, "expectedAnswered": false },
    { "value": "", "expectedAnswered": false },
    { "value": "   ", "expectedAnswered": false },
    { "value": "\t\n", "expectedAnswered": false },
    { "value": "0", "expectedAnswered": true },
    { "value": "no", "expectedAnswered": true },
    { "value": " Anna ", "expectedAnswered": true }
  ]
}
